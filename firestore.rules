    // Collection-group reads power Me → Liked Moments. Restrict the broad
    // collection-group query to like receipts owned by the signed-in user.
    // The nested Moments rule below continues to serve public post like state.
    match /{path=**}/likes/{likeId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /moments/{momentId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
