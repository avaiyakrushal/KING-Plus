rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function activeUser() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/bans/$(request.auth.uid))
            || get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.active != true);
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/live_rooms/$(roomId)).data;
    }
    function roomOwner(roomId) {
      return activeUser() && roomData(roomId).ownerUid == request.auth.uid;
    }
    function roomCoHost(roomId) {
      return activeUser()
        && exists(/databases/$(database)/documents/live_rooms/$(roomId)/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/live_rooms/$(roomId)/roles/$(request.auth.uid)).data.role == 'cohost';
    }
    function roomModerator(roomId) {
      return roomOwner(roomId) || roomCoHost(roomId);
    }
    function roomBanned(roomId, uid) {
      return exists(/databases/$(database)/documents/live_rooms/$(roomId)/room_bans/$(uid))
        && get(/databases/$(database)/documents/live_rooms/$(roomId)/room_bans/$(uid)).data.active == true;
    }
    function roomAccess(roomId) {
      return activeUser()
        && !roomBanned(roomId, request.auth.uid)
        && (roomData(roomId).isPrivate != true
            || roomModerator(roomId)
            || exists(/databases/$(database)/documents/live_rooms/$(roomId)/access/$(request.auth.uid)));
    }
    function roomMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/live_rooms/$(roomId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid);
      allow delete: if false;
      match /devices/{token} {
        allow read, create, update, delete: if owner(uid);
      }
    }

    match /live_rooms/{roomId} {
      // Room cards/metadata remain discoverable to signed-in users. Never store a room password here.
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isPrivate != true;
      allow update: if activeUser() && (
        resource.data.ownerUid == request.auth.uid
        || (roomCoHost(roomId)
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['locked', 'muteAll', 'announcement', 'updatedAt']))
      );
      allow delete: if activeUser() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if roomAccess(roomId);
        allow create: if roomAccess(roomId)
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow update: if roomAccess(roomId)
          && memberUid == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn()
          && (memberUid == request.auth.uid || roomModerator(roomId));
      }

      match /seats/{seatId} {
        allow read: if roomAccess(roomId);
        allow create: if roomAccess(roomId)
          && roomMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && (roomData(roomId).locked != true || roomModerator(roomId));
        allow update: if roomAccess(roomId) && (
          (resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid)
          || (roomModerator(roomId)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['micOn']))
        );
        allow delete: if roomAccess(roomId)
          && (resource.data.uid == request.auth.uid || roomModerator(roomId));
      }

      match /messages/{messageId} {
        allow read: if roomAccess(roomId);
        allow create: if roomAccess(roomId)
          && roomMember(roomId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if roomAccess(roomId);
        allow create: if roomAccess(roomId)
          && (roomMember(roomId) || roomModerator(roomId))
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }

      match /roles/{roleUid} {
        allow read: if signedIn()
          && (roleUid == request.auth.uid || roomModerator(roomId));
        allow create, update: if roomOwner(roomId)
          && roleUid != roomData(roomId).ownerUid
          && request.resource.data.uid == roleUid
          && request.resource.data.role == 'cohost';
        allow delete: if roomOwner(roomId);
      }

      match /room_bans/{bannedUid} {
        allow read: if signedIn()
          && (bannedUid == request.auth.uid || roomModerator(roomId));
        allow create, update: if roomModerator(roomId)
          && bannedUid != roomData(roomId).ownerUid
          && request.resource.data.uid == bannedUid
          && request.resource.data.active == true;
        allow delete: if roomModerator(roomId)
          && bannedUid != roomData(roomId).ownerUid;
      }

      match /access/{accessUid} {
        allow read: if signedIn()
          && (accessUid == request.auth.uid || roomModerator(roomId));
        allow create, update: if roomModerator(roomId)
          && request.resource.data.uid == accessUid;
        allow delete: if roomModerator(roomId);
      }
    }

    match /direct_threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if activeUser()
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 8
        && request.auth.uid in request.resource.data.members;
      allow update: if activeUser() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_threads/$(threadId)).data.members;
        allow create: if activeUser()
          && request.auth.uid in get(/databases/$(database)/documents/direct_threads/$(threadId)).data.members
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid;
      allow delete: if signedIn()
        && (resource.data.followerUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
      allow update: if false;
    }

    match /test_wallet_snapshots/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if false;
    }

    match /wallets/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /wallet_ledger/{entryId} {
      allow read: if signedIn()
        && (admin()
            || resource.data.senderUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
      allow write: if false;
    }

    match /wallet_operations/{operationId} {
      allow read, write: if false;
    }

    match /play_purchase_receipts/{receiptId} {
      allow read: if signedIn() && (admin() || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update: if admin();
      allow delete: if false;
    }

    match /bans/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /account_deletion_requests/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, delete: if owner(uid);
      allow create, update: if false;
    }
  }
}
