    match /relationships/{relationshipId} {
      function relationshipValid9985() {
        return request.resource.data.keys().hasOnly([
            'uidA','uidB','nameA','nameB','initiatorUid','status','createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'uidA','uidB','nameA','nameB','initiatorUid','status','createdAt'
          ])
          && request.resource.data.uidA is string
          && request.resource.data.uidB is string
          && request.resource.data.uidA.size() >= 4
          && request.resource.data.uidB.size() >= 4
          && request.resource.data.uidA.size() <= 128
          && request.resource.data.uidB.size() <= 128
          && request.resource.data.uidA < request.resource.data.uidB
          && relationshipId == request.resource.data.uidA + '__' + request.resource.data.uidB
          && request.resource.data.nameA is string
          && request.resource.data.nameB is string
          && request.resource.data.nameA.size() <= 80
          && request.resource.data.nameB.size() <= 80
          && request.resource.data.initiatorUid == request.auth.uid
          && request.auth.uid in [
              request.resource.data.uidA,request.resource.data.uidB
          ]
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
      }
      allow read: if signedIn()
        && request.auth.uid in [resource.data.uidA,resource.data.uidB];
      allow create: if activeUser()
        && relationshipValid9985()
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.uidA + '_' + request.resource.data.uidB))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.uidB + '_' + request.resource.data.uidA));
      allow update: if activeUser()
        && resource.data.status == 'pending'
        && request.auth.uid in [resource.data.uidA,resource.data.uidB]
        && request.auth.uid != resource.data.initiatorUid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn()
        && request.auth.uid in [resource.data.uidA,resource.data.uidB];
    }

    // Family Admin may kick only a regular member; moderator moderates Chat.
    // Admin/Moderator cannot give themselves roles, mint treasury or impersonate.
    function familyRole9987(code) {
      return get(/databases/$(database)/documents/families/$(code)/members/$(request.auth.uid)).data.role;
    }
    function familyChatModerator9987(code) {
      return familyOwner(code)
        || (familyMember(code) &&
          familyRole9987(code) in ['admin','moderator']);
    }
    function familyAdminCanRemove9987(code) {
      return familyMember(code) && familyRole9987(code) == 'admin';
    }

    match /families/{familyCode} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.code == familyCode
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.level == 1
        && request.resource.data.treasury == 0
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if familyOwner(familyCode)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.level == resource.data.level
        && request.resource.data.treasury == resource.data.treasury
        && request.resource.data.memberCount == resource.data.memberCount;
      allow delete: if familyOwner(familyCode);

      match /members/{memberUid} {
        // Only existing family members and the true Family owner see member UIDs.
        allow read: if familyMember(familyCode) || familyOwner(familyCode);
        function legalFamilyMember9986() {
          return request.resource.data.keys().hasOnly(['uid','name','role','joinedAt'])
            && request.resource.data.keys().hasAll(['uid','name','role','joinedAt'])
            && request.resource.data.uid == memberUid
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
            && request.resource.data.joinedAt == request.time;
        }
        // Join by code, or owner initializes only their own owner record.
        // Firebase role can never be given by typing a fabricated role locally.
        allow create: if activeUser()
          && memberUid == request.auth.uid
          && legalFamilyMember9986()
          && (
            (request.resource.data.role == 'member'
              && exists(/databases/$(database)/documents/families/$(familyCode))
              && familyData(familyCode).ownerUid != request.auth.uid)
            || (request.resource.data.role == 'owner'
              // A first-time Family+owner-member write is one atomic
              // transaction; the parent is only visible in post-commit state.
              && existsAfter(/databases/$(database)/documents/families/$(familyCode))
              && getAfter(/databases/$(database)/documents/families/$(familyCode)).data.ownerUid == request.auth.uid)
          );
        // Exactly the true owner can change another user's role.
        // No edits to name, UID, join time or owner record.
        allow update: if familyOwner(familyCode)
          && memberUid != request.auth.uid
          && memberUid != familyData(familyCode).ownerUid
          && resource.data.uid == memberUid
          && resource.data.role in ['member','moderator','admin']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['member','moderator','admin'];
        // A member may leave; Family owner cannot abandon their own record.
        // Owner can remove any ordinary, moderator or admin member.
        allow delete: if signedIn()
          && memberUid != familyData(familyCode).ownerUid
          && (memberUid == request.auth.uid || familyOwner(familyCode)
            || (familyAdminCanRemove9987(familyCode)
              && memberUid != request.auth.uid
              && resource.data.role == 'member'));
      }

      match /messages/{messageId} {
        allow read: if familyMember(familyCode);
        // Membership and real server timestamp required. Prevent arbitrary
        // status/reward metadata injected through Family Chat.
        allow create: if familyMember(familyCode)
          && request.resource.data.keys().hasOnly(['uid','name','text','createdAt'])
          && request.resource.data.keys().hasAll(['uid','name','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (
          resource.data.uid == request.auth.uid
          || familyChatModerator9987(familyCode));
      }

      match /treasury/{entryId} {
        allow read: if familyMember(familyCode);
        allow create: if false; // NO real currency without trusted backend
        allow update: if false;
        allow delete: if familyOwner(familyCode);
      }

      match /activities/{activityId} {
        allow read: if familyMember(familyCode);
        allow create, update: if familyMember(familyCode)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type is string;
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || familyOwner(familyCode));
      }
    }

    match /direct_threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if activeUser()
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 8
        && request.auth.uid in request.resource.data.members;
      allow update: if activeUser() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_threads/$(threadId)).data.members;
        allow create: if activeUser()
          && request.auth.uid in get(/databases/$(database)/documents/direct_threads/$(threadId)).data.members
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid is string
          && request.resource.data.recipientUid != request.auth.uid
          && request.resource.data.recipientUid in
             get(/databases/$(database)/documents/direct_threads/$(threadId)).data.members
          && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + request.resource.data.recipientUid))
          && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.recipientUid + '_' + request.auth.uid))
          && (!exists(/databases/$(database)/documents/king_me_preferences/$(request.resource.data.recipientUid))
              || get(/databases/$(database)/documents/king_me_preferences/$(request.resource.data.recipientUid)).data.allowPrivateMessages == true)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && followId == request.auth.uid + '__' + request.resource.data.targetUid;
      allow delete: if signedIn()
        && (resource.data.followerUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
      allow update: if false;
    }

    match /test_wallet_snapshots/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if false;
    }

    // KING Agency/Agent governance. No client-side actual recharge, payment,
    // credit, VIP, or balance write, even by a Super Admin.
    function kingAgencyActive9982(agencyUid) {
      return signedIn() && agencyUid is string
        && exists(/databases/$(database)/documents/king_agencies/$(agencyUid))
        && get(/databases/$(database)/documents/king_agencies/$(agencyUid)).data.active == true;
    }
    function kingAgentActive9982(agentUid, agencyUid) {
      return signedIn() && agentUid is string
        && exists(/databases/$(database)/documents/king_agents/$(agentUid))
        && get(/databases/$(database)/documents/king_agents/$(agentUid)).data.active == true
        && get(/databases/$(database)/documents/king_agents/$(agentUid)).data.agencyUid == agencyUid;
    }
    function kingPack9982(value) {
      return value in [100, 600, 1300];
    }
    match /king_agencies/{agencyUid} {
      allow get, list: if admin() || owner(agencyUid);
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['uid','name','active','approvedByUid','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','name','active','approvedByUid','createdAt','updatedAt'])
        && request.resource.data.uid == agencyUid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.active == true
        && request.resource.data.approvedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if admin()
        && request.resource.data.keys().hasOnly(['uid','name','active','approvedByUid','createdAt','updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.approvedByUid is string
        && request.resource.data.approvedByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /king_agents/{agentUid} {
      allow get: if admin() || owner(agentUid)
        || (signedIn() && resource.data.agencyUid == request.auth.uid
            && kingAgencyActive9982(request.auth.uid));
      allow list: if admin() || (signedIn()
        && resource.data.agencyUid == request.auth.uid
        && kingAgencyActive9982(request.auth.uid));
      allow create: if signedIn()
        && kingAgencyActive9982(request.auth.uid)
        && agentUid != request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','agencyUid','active','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','agencyUid','active','createdAt','updatedAt'])
        && request.resource.data.uid == agentUid
        && request.resource.data.agencyUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && kingAgencyActive9982(request.auth.uid)
        && resource.data.agencyUid == request.auth.uid
        && resource.data.uid == agentUid
        && request.resource.data.keys().hasOnly(['uid','agencyUid','active','createdAt','updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.agencyUid == resource.data.agencyUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /king_agent_recharge_requests/{orderId} {
      allow read: if signedIn() && (admin()
        || resource.data.agentUid == request.auth.uid
        || (resource.data.agencyUid == request.auth.uid
            && kingAgencyActive9982(request.auth.uid)));
      // A request is only a pending order, not a verified money movement.
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          'agentUid','agencyUid','targetUid','diamonds','status','createdAt'])
        && request.resource.data.keys().hasAll([
          'agentUid','agencyUid','targetUid','diamonds','status','createdAt'])
        && request.resource.data.agentUid == request.auth.uid
        && request.resource.data.agencyUid is string
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() >= 4
        && request.resource.data.targetUid.size() <= 128
        && request.resource.data.status == 'pending'
        && kingPack9982(request.resource.data.diamonds)
        && request.resource.data.createdAt == request.time
        && kingAgencyActive9982(request.resource.data.agencyUid)
        && (request.resource.data.agencyUid == request.auth.uid
          || kingAgentActive9982(request.auth.uid, request.resource.data.agencyUid));
      // Even Super Admin cannot mark fake payment "approved" through client.
      // Actual credits may only be performed by verified trusted backend
      // with idempotent merchant receipt and append-only wallet ledger.
      allow update, delete: if false;
    }

    // Public gift WISH is a profile preference, NOT wallet credit or paid
    // entitlement. Only the account owner can create/change a fixed wish.
    match /king_me_wishes/{uid} {
      allow read: if signedIn();
      allow create: if activeUser() && owner(uid)
        && request.resource.data.keys().hasOnly(['uid','wish','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','wish','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.wish in [
          'Royal Castle','Galaxy Ship','King Dragon','VIP Crown','Diamond Rain']
        && request.resource.data.updatedAt == request.time;
      allow update: if activeUser() && owner(uid)
        && resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','wish','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','wish','updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.wish in [
          'Royal Castle','Galaxy Ship','King Dragon','VIP Crown','Diamond Rain']
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner(uid);
    }

    // Account-owned Me Privacy and Notifications. Choices are synced, not
    // server-issued privileges or a false promise of FCM delivery filtering.
    match /king_me_preferences/{uid} {
      function validMe9984() {
        return request.resource.data.keys().hasOnly([
            'uid','findMe','showOnlineStatus','allowRoomInvites',
            'allowPrivateMessages','showEntranceEffects','notifyMessages',
            'notifySocial','notifyRoomInvites','notifyGifts','notifyGames',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'uid','findMe','showOnlineStatus','allowRoomInvites',
            'allowPrivateMessages','showEntranceEffects','notifyMessages',
            'notifySocial','notifyRoomInvites','notifyGifts','notifyGames',
            'updatedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.findMe is bool
          && request.resource.data.showOnlineStatus is bool
          && request.resource.data.allowRoomInvites is bool
          && request.resource.data.allowPrivateMessages is bool
          && request.resource.data.showEntranceEffects is bool
          && request.resource.data.notifyMessages is bool
          && request.resource.data.notifySocial is bool
          && request.resource.data.notifyRoomInvites is bool
          && request.resource.data.notifyGifts is bool
          && request.resource.data.notifyGames is bool
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner(uid);
      allow create: if activeUser() && owner(uid) && validMe9984();
      allow update: if activeUser() && owner(uid) && validMe9984()
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Public VIP/Noble is never minted by a client's public profile metadata.
    // The trusted Wallet Server is authoritative for this user's paid VIP;
    // signed-in viewers use this *separate* server-only public grant doc.
    // Purchasable premium cosmetics: no client can fabricate paid ownership,
    // reserve another member's number, set prices, or deduct a wallet balance.
    match /king_vip_style_catalog/{docId} {
      allow read: if signedIn() && docId == 'current';
      allow write: if false;
    }
    match /king_vip_identity_grants/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /king_vip_number_registry/{number} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }

    match /king_public_prestige/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Cashfree pricing, order-to-account mapping and paid receipts are admin-only.
    // No client can self-set a price, fabricate a paid receipt or mint Diamonds.
    match /cashfree_recharge_catalog/{sku} { allow read, write: if false; }
    match /cashfree_recharge_orders/{orderId} { allow read, write: if false; }
    match /cashfree_recharge_active/{slotId} { allow read, write: if false; }
    match /cashfree_recharge_receipts/{receiptId} { allow read, write: if false; }

    match /wallets/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /wallet_ledger/{entryId} {
      allow read: if signedIn()
        && (admin()
            || resource.data.senderUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
      allow write: if false;
    }

    match /wallet_operations/{operationId} {
      allow read, write: if false;
    }

    match /play_purchase_receipts/{receiptId} {
      allow read: if signedIn() && (admin() || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update: if admin();
      allow delete: if false;
    }

    // A submitter may read only their own immutable receipt copies. These
    // receipts contain no moderation decision or other users' report data.
    match /user_report_history/{uid}/items/{reportId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'reporterUid','reportId','target','reason','submittedAt'
        ])
        && request.resource.data.keys().hasAll([
          'reporterUid','reportId','target','reason','submittedAt'
        ])
        && request.resource.data.reporterUid == uid
        && request.resource.data.reportId == reportId
        && request.resource.data.target is string
        && request.resource.data.target.size() > 0
        && request.resource.data.target.size() <= 160
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 240
        && request.resource.data.submittedAt == request.time
        && existsAfter(/databases/$(database)/documents/reports/$(reportId))
        && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.reporterUid == uid
        && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.target == request.resource.data.target
        && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.reason == request.resource.data.reason;
      allow update, delete: if false;
    }

    match /bans/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /account_deletion_requests/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /king_daily_checkins/{uid} {
      allow read: if owner(uid) && activeUser();
      allow create, update, delete: if false;
      match /events/{dayId} {
        allow read: if owner(uid) && activeUser();
        allow create, update, delete: if false;
      }
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, delete: if owner(uid);
      allow update: if owner(uid)
        && resource.data.read == false
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false;
    }
  }
}
