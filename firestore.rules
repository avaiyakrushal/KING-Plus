      allow update: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.get('vipLevel',0) == resource.data.get('vipLevel',0)
        && request.resource.data.get('vipPoints',0) == resource.data.get('vipPoints',0)
        && request.resource.data.get('nobleLevel',0) == resource.data.get('nobleLevel',0);
      allow delete: if owner(uid);

      match /visitors/{visitorUid} {
        allow read: if signedIn() && request.auth.uid == uid;
