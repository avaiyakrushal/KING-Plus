rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function activeUser() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/bans/$(request.auth.uid))
            || get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.active != true);
    }
    function roomOwner(roomId) {
      return signedIn()
        && get(/databases/$(database)/documents/live_rooms/$(roomId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid);
      allow delete: if false;
      match /devices/{token} {
        allow read, create, update, delete: if owner(uid);
      }
    }

    match /live_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if activeUser() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if activeUser() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if signedIn();
        allow create, update: if activeUser()
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn()
          && (memberUid == request.auth.uid || roomOwner(roomId));
      }

      match /seats/{seatId} {
        allow read: if signedIn();
        allow create: if activeUser()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string;
        allow update: if activeUser()
          && request.resource.data.uid == resource.data.uid
          && (resource.data.uid == request.auth.uid || roomOwner(roomId));
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || roomOwner(roomId));
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if activeUser()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if activeUser()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }
    }

    match /direct_threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if activeUser()
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 8
        && request.auth.uid in request.resource.data.members;
      allow update: if activeUser() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_threads/$(threadId)).data.members;
        allow create: if activeUser()
          && request.auth.uid in get(/databases/$(database)/documents/direct_threads/$(threadId)).data.members
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid;
      allow delete: if signedIn()
        && (resource.data.followerUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
      allow update: if false;
    }

    match /test_wallet_snapshots/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if false;
    }

    match /wallets/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /wallet_ledger/{entryId} {
      allow read: if signedIn()
        && (admin()
            || resource.data.senderUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
      allow write: if false;
    }

    match /wallet_operations/{operationId} {
      allow read, write: if false;
    }

    match /play_purchase_receipts/{receiptId} {
      allow read: if signedIn() && (admin() || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update: if admin();
      allow delete: if false;
    }

    match /bans/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /account_deletion_requests/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, delete: if owner(uid);
      allow create, update: if false;
    }
  }
}
