        && request.resource.data.revision is int
        && request.resource.data.selected is int && request.resource.data.selected >= -1 && request.resource.data.selected < 4
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('partyRoomKey','') == resource.data.get('partyRoomKey','')
        && request.resource.data.schema == resource.data.schema && request.resource.data.capacity == resource.data.capacity
        && request.resource.data.revision == resource.data.revision+1
        && (request.auth.uid in resource.data.players || request.resource.data.action == 'join')
        && action(resource.data,request.resource.data);
      allow delete: if activeUser() && party(resource.data) && resource.data.ownerUid == request.auth.uid
