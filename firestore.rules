        && activeUser() && shape(request.resource.data) && party(request.resource.data)
        && (request.resource.data.get('partyRoomKey','') == '' || roomModerator(request.resource.data.partyRoomKey))
        && request.resource.data.players == [request.auth.uid,'','','']
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.names[0].size() > 0
        && request.resource.data.names[1] == '' && request.resource.data.names[2] == '' && request.resource.data.names[3] == ''
        && request.resource.data.phase == 'lobby'
        && request.resource.data.revision == 0 && request.resource.data.action == 'create'
        && request.resource.data.selected == -1 && request.resource.data.rollAt == request.time && freshBoard(request.resource.data);
