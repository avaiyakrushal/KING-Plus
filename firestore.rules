rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function activeUser() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/bans/$(request.auth.uid))
            || get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.active != true);
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/live_rooms/$(roomId)).data;
    }
    function roomOwner(roomId) {
      return activeUser() && roomData(roomId).ownerUid == request.auth.uid;
    }
    function roomCoHost(roomId) {
      return activeUser()
        && exists(/databases/$(database)/documents/live_rooms/$(roomId)/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/live_rooms/$(roomId)/roles/$(request.auth.uid)).data.role == 'cohost';
    }
    function roomModerator(roomId) {
      return roomOwner(roomId) || roomCoHost(roomId);
    }
    function roomBanned(roomId, uid) {
      return exists(/databases/$(database)/documents/live_rooms/$(roomId)/room_bans/$(uid))
        && get(/databases/$(database)/documents/live_rooms/$(roomId)/room_bans/$(uid)).data.active == true;
    }
    function roomAccess(roomId) {
      return activeUser()
        && !roomBanned(roomId, request.auth.uid)
        && (roomData(roomId).isPrivate != true
            || roomModerator(roomId)
            || exists(/databases/$(database)/documents/live_rooms/$(roomId)/access/$(request.auth.uid)));
    }
    function roomMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/live_rooms/$(roomId)/members/$(request.auth.uid));
    }
    function seatLocked(roomId, seatId) {
      return exists(/databases/$(database)/documents/live_rooms/$(roomId)/seat_locks/$(seatId))
        && get(/databases/$(database)/documents/live_rooms/$(roomId)/seat_locks/$(seatId)).data.locked == true;
    }
    function familyData(familyCode) {
      return get(/databases/$(database)/documents/families/$(familyCode)).data;
    }
    function familyOwner(familyCode) {
      return activeUser() && familyData(familyCode).ownerUid == request.auth.uid;
    }
    function familyMember(familyCode) {
      return activeUser()
        && exists(/databases/$(database)/documents/families/$(familyCode)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid);
      allow delete: if false;
      match /devices/{token} {
        allow read, create, update, delete: if owner(uid);
      }
    }

    match /live_rooms/{roomId} {
      // Room cards/metadata remain discoverable to signed-in users. Never store a room password here.
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow update: if activeUser() && (
        resource.data.ownerUid == request.auth.uid
        || (roomCoHost(roomId)
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['locked', 'muteAll', 'announcement', 'updatedAt']))
      );
      allow delete: if activeUser() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if roomAccess(roomId);
        allow create: if roomAccess(roomId)
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow update: if roomAccess(roomId)
          && memberUid == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn()
          && (memberUid == request.auth.uid || roomModerator(roomId));
      }

      match /seats/{seatId} {
        allow read: if roomAccess(roomId);
        allow create: if roomAccess(roomId) && request.resource.data.name is string && (
          (roomMember(roomId)
            && request.resource.data.uid == request.auth.uid
            && roomData(roomId).locked != true
            && !seatLocked(roomId, seatId))
          || (roomModerator(roomId)
            && request.resource.data.uid is string
            && exists(/databases/$(database)/documents/live_rooms/$(roomId)/members/$(request.resource.data.uid)))
        );
        allow update: if roomAccess(roomId) && (
          (resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['micOn']))
          || (roomModerator(roomId)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['micOn']))
        );
        allow delete: if roomAccess(roomId)
          && (resource.data.uid == request.auth.uid || roomModerator(roomId));
      }

      match /messages/{messageId} {
        allow read: if roomAccess(roomId);
        allow create: if roomAccess(roomId)
          && roomMember(roomId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if roomAccess(roomId);
        allow create: if roomAccess(roomId)
          && (roomMember(roomId) || roomModerator(roomId))
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }

      match /roles/{roleUid} {
        allow read: if signedIn()
          && (roleUid == request.auth.uid || roomModerator(roomId));
        allow create, update: if roomOwner(roomId)
          && roleUid != roomData(roomId).ownerUid
          && request.resource.data.uid == roleUid
          && request.resource.data.role == 'cohost';
        allow delete: if roomOwner(roomId);
      }

      match /room_bans/{bannedUid} {
        allow read: if signedIn()
          && (bannedUid == request.auth.uid || roomModerator(roomId));
        allow create, update: if roomModerator(roomId)
          && bannedUid != roomData(roomId).ownerUid
          && request.resource.data.uid == bannedUid
          && request.resource.data.active == true;
        allow delete: if roomModerator(roomId)
          && bannedUid != roomData(roomId).ownerUid;
      }

      match /secrets/{secretId} {
        // Password hashes are write-only from the client perspective.
        allow read: if false;
        allow create, update, delete: if roomOwner(roomId);
      }

      match /seat_locks/{seatId} {
        allow read: if roomAccess(roomId);
        allow create, update: if roomModerator(roomId)
          && request.resource.data.locked == true;
        allow delete: if roomModerator(roomId);
      }

      match /seat_requests/{requestId} {
        allow read: if signedIn()
          && (roomModerator(roomId)
              || (roomAccess(roomId) && resource.data.uid == request.auth.uid));
        allow create: if roomAccess(roomId)
          && roomMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.seatNo is int
          && request.resource.data.seatNo >= 1
          && request.resource.data.seatNo <= 12;
        allow update: if false;
        allow delete: if signedIn()
          && (roomModerator(roomId) || resource.data.uid == request.auth.uid);
      }

      // v9.x realtime room features. Keep writes scoped to the signed-in
      // member or the room moderator so UI-only features actually work multi-user.
      match /seat_invites/{targetUid} {
        allow read: if signedIn()
          && (targetUid == request.auth.uid || roomModerator(roomId));
        allow create, update: if roomModerator(roomId)
          && request.resource.data.targetUid == targetUid
          && request.resource.data.invitedByUid == request.auth.uid;
        allow delete: if signedIn()
          && (targetUid == request.auth.uid || roomModerator(roomId));
      }

      match /game_ready/{playerUid} {
        allow read: if roomAccess(roomId);
        allow create, update: if roomAccess(roomId)
          && roomMember(roomId)
          && playerUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn()
          && (playerUid == request.auth.uid || roomModerator(roomId));
      }

      match /game_moves/{playerUid} {
        allow read: if roomAccess(roomId);
        allow create, update: if roomAccess(roomId)
          && roomMember(roomId)
          && playerUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn()
          && (playerUid == request.auth.uid || roomModerator(roomId));
      }

      match /game_state/{stateId} {
        allow read: if roomAccess(roomId);
        allow create, update, delete: if roomModerator(roomId);
      }

      match /game_votes/{playerUid} {
        allow read: if roomAccess(roomId)
          && (playerUid == request.auth.uid || roomModerator(roomId));
        allow create, update: if roomAccess(roomId)
          && roomMember(roomId)
          && playerUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn()
          && (playerUid == request.auth.uid || roomModerator(roomId));
      }

      match /room_invites/{inviteId} {
        allow read: if signedIn()
          && (roomModerator(roomId)
              || resource.data.recipientUid == request.auth.uid);
        allow create, update: if roomModerator(roomId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid is string;
        allow delete: if signedIn()
          && (roomModerator(roomId)
              || resource.data.recipientUid == request.auth.uid);
      }

      match /room_settings/{settingId} {
        allow read: if roomAccess(roomId);
        allow create, update, delete: if roomModerator(roomId);
      }

      match /room_templates/{templateId} {
        allow read: if roomAccess(roomId);
        allow create, update: if roomModerator(roomId)
          && request.resource.data.actorUid == request.auth.uid;
        allow delete: if roomModerator(roomId);
      }

      match /music_playlist/{songId} {
        allow read: if roomAccess(roomId);
        allow create: if roomModerator(roomId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.url is string
          && request.resource.data.name is string;
        allow update, delete: if roomModerator(roomId);
      }

      match /music_state/{stateId} {
        allow read: if roomAccess(roomId);
        allow create, update: if roomModerator(roomId)
          && request.resource.data.actorUid == request.auth.uid;
        allow delete: if roomModerator(roomId);
      }

      match /access/{accessUid} {
        // Access markers are intentionally not client-readable. roomAccess() only needs exists().
        allow read: if false;
        allow create: if (
          roomModerator(roomId)
          && request.resource.data.uid == accessUid
        ) || (
          activeUser()
          && accessUid == request.auth.uid
          && roomData(roomId).isPrivate == true
          && roomData(roomId).hasPassword == true
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.passwordHash is string
          && request.resource.data.passwordHash
             == get(/databases/$(database)/documents/live_rooms/$(roomId)/secrets/password).data.passwordHash
        );
        allow update: if roomModerator(roomId)
          && request.resource.data.uid == accessUid;
        allow delete: if roomModerator(roomId);
      }
    }

    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid)
        && request.resource.data.uid == uid;
      allow delete: if owner(uid);

      match /visitors/{visitorUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if activeUser()
          && visitorUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn()
          && (request.auth.uid == uid || request.auth.uid == visitorUid);
      }
    }

    match /discover_stats/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid);
      allow delete: if owner(uid);
    }

    match /blocks/{blockId} {
      allow read: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if activeUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /ludo_matches/{matchCode} {
      // Room-code discovery requires signed-in players to read before joining.
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.code == matchCode
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.players is list
        && request.resource.data.players.size() == 4
        && request.resource.data.players[0] == request.auth.uid
        && request.resource.data.capacity in [2, 4];
      allow update: if activeUser()
        && request.resource.data.code == resource.data.code
        && request.resource.data.players is list
        && request.resource.data.players.size() == 4
        && request.resource.data.actorUid == request.auth.uid
        && (
          request.auth.uid in resource.data.players
          || (resource.data.phase == 'lobby'
              && request.auth.uid in request.resource.data.players)
        );
      allow delete: if activeUser()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /moments/{momentId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, update: if activeUser()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && uid == request.auth.uid;
      }
    }

    match /relationships/{relationshipId} {
      allow read: if signedIn()
        && (resource.data.uidA == request.auth.uid
            || resource.data.uidB == request.auth.uid);
      allow create: if activeUser()
        && request.resource.data.uidA is string
        && request.resource.data.uidB is string
        && request.resource.data.uidA != request.resource.data.uidB
        && (request.resource.data.uidA == request.auth.uid
            || request.resource.data.uidB == request.auth.uid)
        && request.resource.data.initiatorUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if activeUser()
        && (resource.data.uidA == request.auth.uid
            || resource.data.uidB == request.auth.uid)
        && request.resource.data.uidA == resource.data.uidA
        && request.resource.data.uidB == resource.data.uidB
        && request.resource.data.initiatorUid == resource.data.initiatorUid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt']);
      allow delete: if signedIn()
        && (resource.data.uidA == request.auth.uid
            || resource.data.uidB == request.auth.uid);
    }

    match /families/{familyCode} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.code == familyCode
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow update, delete: if familyOwner(familyCode);

      match /members/{memberUid} {
        allow read: if familyMember(familyCode) || familyOwner(familyCode);
        allow create: if activeUser()
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && (
            request.resource.data.role == 'member'
            || (request.resource.data.role == 'owner' && familyOwner(familyCode))
          );
        allow update: if activeUser()
          && (memberUid == request.auth.uid || familyOwner(familyCode))
          && request.resource.data.uid == memberUid;
        allow delete: if signedIn()
          && (memberUid == request.auth.uid || familyOwner(familyCode));
      }

      match /messages/{messageId} {
        allow read: if familyMember(familyCode);
        allow create: if familyMember(familyCode)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || familyOwner(familyCode));
      }

      match /treasury/{entryId} {
        allow read: if familyMember(familyCode);
        allow create: if familyMember(familyCode)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 10000;
        allow update: if false;
        allow delete: if familyOwner(familyCode);
      }

      match /activities/{activityId} {
        allow read: if familyMember(familyCode);
        allow create, update: if familyMember(familyCode)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type is string;
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || familyOwner(familyCode));
      }
    }

    match /direct_threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if activeUser()
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 8
        && request.auth.uid in request.resource.data.members;
      allow update: if activeUser() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_threads/$(threadId)).data.members;
        allow create: if activeUser()
          && request.auth.uid in get(/databases/$(database)/documents/direct_threads/$(threadId)).data.members
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid;
      allow delete: if signedIn()
        && (resource.data.followerUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
      allow update: if false;
    }

    match /test_wallet_snapshots/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if false;
    }

    match /wallets/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /wallet_ledger/{entryId} {
      allow read: if signedIn()
        && (admin()
            || resource.data.senderUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
      allow write: if false;
    }

    match /wallet_operations/{operationId} {
      allow read, write: if false;
    }

    match /play_purchase_receipts/{receiptId} {
      allow read: if signedIn() && (admin() || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update: if admin();
      allow delete: if false;
    }

    match /bans/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /account_deletion_requests/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, delete: if owner(uid);
      allow update: if owner(uid)
        && resource.data.read == false
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false;
    }
  }
}
