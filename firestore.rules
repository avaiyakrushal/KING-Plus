rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid);
      allow delete: if false;
      match /devices/{token} {
        allow read, create, update, delete: if owner(uid);
      }
    }

    match /live_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    match /test_wallet_snapshots/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if false;
    }

    match /wallets/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /wallet_ledger/{entryId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update: if admin();
      allow delete: if false;
    }

    match /bans/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, delete: if owner(uid);
      allow create, update: if false;
    }
  }
}
