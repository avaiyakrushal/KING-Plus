<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="#152B52" android:contentDescription="Room Games neon progress regular preview">
<TextView android:id="@+id/king_catalog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎮 Room Games · progress" android:textColor="#7CFFDE" android:textSize="19sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Playable KING games and results · neon · regular" android:textColor="#E5FAFF" android:textSize="13sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Room Games" android:textColor="#7CFFDE" android:textSize="13sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<ProgressBar android:id="@+id/king_catalog_meter" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="16dp" android:max="100" android:progress="42"/>
<TextView android:id="@+id/king_catalog_action" android:layout_width="match_parent" android:layout_height="32dp" android:text="OPEN ROOM GAMES  ›" android:textColor="#152B52" android:textSize="14sp" android:background="#7CFFDE" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
</LinearLayout>
