<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="22dp" android:background="#143559" android:contentDescription="Wallet sky progress large preview">
<TextView android:id="@+id/king_catalog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="💎 Wallet · progress" android:textColor="#99DFFF" android:textSize="23sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Balance and verified receipt security · sky · large" android:textColor="#E6F7FF" android:textSize="15sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Wallet" android:textColor="#99DFFF" android:textSize="15sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<ProgressBar android:id="@+id/king_catalog_meter" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="22dp" android:max="100" android:progress="42"/>
<TextView android:id="@+id/king_catalog_action" android:layout_width="match_parent" android:layout_height="40dp" android:text="OPEN WALLET  ›" android:textColor="#143559" android:textSize="16sp" android:background="#99DFFF" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
</LinearLayout>
