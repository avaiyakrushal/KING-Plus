<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="22dp" android:background="#152B52" android:contentDescription="Social neon progress large preview">
<TextView android:id="@+id/king_catalog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="💬 Social · progress" android:textColor="#7CFFDE" android:textSize="23sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Friends, following and moments · neon · large" android:textColor="#E5FAFF" android:textSize="15sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Social" android:textColor="#7CFFDE" android:textSize="15sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<ProgressBar android:id="@+id/king_catalog_meter" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="22dp" android:max="100" android:progress="42"/>
<TextView android:id="@+id/king_catalog_action" android:layout_width="match_parent" android:layout_height="40dp" android:text="OPEN SOCIAL  ›" android:textColor="#152B52" android:textSize="16sp" android:background="#7CFFDE" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
</LinearLayout>
