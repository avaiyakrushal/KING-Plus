<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="#153D34" android:contentDescription="Social forest roster compact preview">
<TextView android:id="@+id/king_catalog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="💬 Social · roster" android:textColor="#B9FFC6" android:textSize="16sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Friends, following and moments · forest · compact" android:textColor="#E9FFF2" android:textSize="12sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/king_catalog_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Social" android:textColor="#B9FFC6" android:textSize="12sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/king_catalog_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="◆ Forest" android:textColor="#E9FFF2" android:textSize="12sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
</LinearLayout>
</LinearLayout>
<TextView android:id="@+id/king_catalog_action" android:layout_width="match_parent" android:layout_height="28dp" android:text="OPEN SOCIAL  ›" android:textColor="#153D34" android:textSize="13sp" android:background="#B9FFC6" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
</LinearLayout>
