<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="22dp" android:background="#252064" android:contentDescription="KING Family indigo progress large preview">
<TextView android:id="@+id/king_catalog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🏠 KING Family · progress" android:textColor="#D3C7FF" android:textSize="23sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Members and family room tools · indigo · large" android:textColor="#F1EFFF" android:textSize="15sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
