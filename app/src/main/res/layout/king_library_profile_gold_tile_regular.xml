<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="#412310" android:contentDescription="Profile gold tile regular preview">
<TextView android:id="@+id/king_catalog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="👤 Profile · tile" android:textColor="#FFDE77" android:textSize="19sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Identity, medals and visitors · gold · regular" android:textColor="#FCECD5" android:textSize="13sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
