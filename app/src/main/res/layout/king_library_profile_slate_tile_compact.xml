<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="#293241" android:contentDescription="Profile slate tile compact preview">
<TextView android:id="@+id/king_catalog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="👤 Profile · tile" android:textColor="#CBD5E1" android:textSize="16sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Identity, medals and visitors · slate · compact" android:textColor="#F8FAFC" android:textSize="12sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▣ Profile Tile" android:textColor="#CBD5E1" android:textSize="12sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open the live KING feature" android:textColor="#F8FAFC" android:textSize="12sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_action" android:layout_width="match_parent" android:layout_height="28dp" android:text="OPEN PROFILE  ›" android:textColor="#293241" android:textSize="13sp" android:background="#CBD5E1" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
</LinearLayout>
