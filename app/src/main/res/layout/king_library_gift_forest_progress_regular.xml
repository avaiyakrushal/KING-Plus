<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="#153D34" android:contentDescription="Gifting forest progress regular preview">
<TextView android:id="@+id/king_catalog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎁 Gifting · progress" android:textColor="#B9FFC6" android:textSize="19sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gift previews, quantity and history · forest · regular" android:textColor="#E9FFF2" android:textSize="13sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Gifting" android:textColor="#B9FFC6" android:textSize="13sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<ProgressBar android:id="@+id/king_catalog_meter" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="16dp" android:max="100" android:progress="42"/>
<TextView android:id="@+id/king_catalog_action" android:layout_width="match_parent" android:layout_height="32dp" android:text="OPEN GIFTING  ›" android:textColor="#153D34" android:textSize="14sp" android:background="#B9FFC6" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
</LinearLayout>
