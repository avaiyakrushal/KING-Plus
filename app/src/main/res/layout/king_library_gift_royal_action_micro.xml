<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:background="#452483" android:contentDescription="Gifting royal action micro preview">
<TextView android:id="@+id/king_catalog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎁 Gifting · action" android:textColor="#FFE49C" android:textSize="14sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gift previews, quantity and history · royal · micro" android:textColor="#F5EFFF" android:textSize="11sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="○ Preview only" android:textColor="#FFE49C" android:textSize="11sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No Diamonds are deducted" android:textColor="#F5EFFF" android:textSize="11sp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
<TextView android:id="@+id/king_catalog_action" android:layout_width="match_parent" android:layout_height="28dp" android:text="OPEN GIFTING  ›" android:textColor="#452483" android:textSize="12sp" android:background="#FFE49C" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2"/>
</LinearLayout>
