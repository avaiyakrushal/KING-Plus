+        DocumentReference ref=db.collection("users").document(uid);
+        db.runTransaction(tx->{
+            if(!account(uid))throw new IllegalStateException("Account changed");
+            DocumentSnapshot doc=tx.get(ref);
+            Object current=doc.contains(KingSavedRoomsPolicy9990.FIELD)
+                ?doc.get(KingSavedRoomsPolicy9990.FIELD):local(context,uid);
+            Map<String,Object> update=new HashMap<>();
+            update.put(KingSavedRoomsPolicy9990.FIELD,KingSavedRoomsPolicy9990.remove(current,id));
+            tx.set(ref,update,SetOptions.mergeFields(KingSavedRoomsPolicy9990.FIELD));
+            return null;
+        }).addOnSuccessListener(v->result.done(account(uid)?null:new IllegalStateException("Account changed")))
+          .addOnFailureListener(result::done);
+    }
